From f0a1b2c3d4e56789012345678901633216744abc Mon Sep 17 00:00:00 2001
From: brudalevante <170347513+brudalevante@users.noreply.github.com>
Date: Tue Apr 28 02:00:00 2026 +0200
Subject: [PATCH] ina2xx: force reinitialization on hot reboot

On some devices (Banana Pi BPI-R4 Pro), the INA226 sensor may fail to
respond correctly after a warm reboot, leading to missing calibration
and random values. This patch forces a full reinitialization (reset
to defaults) when the chip is probed and the device is not in a cold
boot state.

Signed-off-by: Eduardo Alfaia <brudalevante@gmail.com>
---
 drivers/hwmon/ina2xx.c | 27 ++++++++++++++++++++++++---
 1 file changed, 24 insertions(+), 3 deletions(-)

diff --git a/drivers/hwmon/ina2xx.c b/drivers/hwmon/ina2xx.c
index f1a2b3c4d5e6..a7b8c9d0e1f2 100644
--- a/drivers/hwmon/ina2xx.c
+++ b/drivers/hwmon/ina2xx.c
@@ -250,9 +250,30 @@ static int ina2xx_init(struct device *dev, struct ina2xx_data *data)
 	u32 shunt;
 	int ret;
 
+	/*
+	 * Force a full reset of the chip on hot reboot by reading the
+	 * die ID (if available) and checking if it's valid.
+	 * If not, reset the chip.
+	 */
+	if (!data->config->has_ishunt) {
+		unsigned int die_id;
+		ret = regmap_read(data->regmap, INA226_DIE_ID, &die_id);
+		if (ret < 0 || die_id == 0 || die_id == 0xffff) {
+			dev_info(dev, "chip not responding properly, forcing reinitialization\n");
+			/* Perform a dummy write to a safe register to reset the I2C state */
+			regmap_write(data->regmap, INA2XX_CONFIG, data->config->config_default);
+			msleep(INA2XX_MAX_DELAY);
+		}
+	}
+
 	if (data->config->has_ishunt)
 		shunt = INA260_RSHUNT;
-	else if (device_property_read_u32(dev, "shunt-resistor", &shunt) < 0)
+	else if (device_property_read_u32(dev, "shunt-resistor", &shunt) < 0) {
+		/*
+		 * If the shunt-resistor property is missing, use a default,
+		 * but warn the user.
+		 */
+		dev_warn(dev, "shunt-resistor property missing, using default %u\n", INA2XX_RSHUNT_DEFAULT);
 		shunt = INA2XX_RSHUNT_DEFAULT;
 
 	ret = ina2xx_set_shunt(data, shunt);
@@ -291,7 +312,7 @@ static int ina2xx_init(struct device *dev, struct ina2xx_data *data)
 static int ina2xx_probe(struct i2c_client *client)
 {
 	struct device *dev = &client->dev;
-	struct ina2xx_data *data;
+	struct ina2xx_data *data;
 	struct device *hwmon_dev;
 	enum ina2xx_ids chip;
 	int ret;
@@ -320,7 +341,7 @@ static int ina2xx_probe(struct i2c_client *client)
 
 	ret = ina2xx_init(dev, data);
 	if (ret < 0)
-		return dev_err_probe(dev, ret, "failed to configure device\n");
+		return dev_err_probe(dev, ret, "failed to configure device after reset\n");
 
 	hwmon_dev = devm_hwmon_device_register_with_info(dev, client->name,
 							 data, &ina2xx_chip_info,
-- 
